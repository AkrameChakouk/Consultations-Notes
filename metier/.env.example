# Copier ce fichier en ".env" puis adapter les valeurs. Le fichier ".env" n'est jamais publié sur GitHub.
# Charger ensuite les variables dans le terminal :   set -a; source .env; set +a

# --- Base de données (couche données) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notes_db
DB_USER=notes_user
DB_PASSWORD=notes_password

# --- API (couche métier) ---
HOST=127.0.0.1
PORT=5000
# Clé secrète qui signe les jetons de session : à changer et à garder secrète
SECRET_KEY=changez-moi-avec-une-longue-phrase-secrete
TOKEN_DUREE_SECONDES=3600

# --- Adresse du client autorisée à appeler l'API (CORS) ; * = toutes ---
CORS_ORIGINE=*
